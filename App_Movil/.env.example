# demo works without Firebase or a trained predictor. live requires both Firebase and API.
EXPO_PUBLIC_APP_MODE=demo
# On a phone use the computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
