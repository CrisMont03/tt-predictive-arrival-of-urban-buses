# Resultados generados al procesar videos
**/output/
**/output_*/

# Entornos virtuales y caché de Python
**/.venv/
**/__pycache__/
*.py[cod]

# Videos y modelos locales pesados
*.mp4
*.pt

# Archivos de macOS
.DS_Store

# Local environment values (keep sanitized templates versioned)
.env
.env.*
*.env
.envrc
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Local infrastructure configuration
/Infra/config.local.json

# Administrative credentials and local secret directories
# Store service-account keys outside the repository whenever possible.
*service-account*.json
*service_account*.json
*serviceAccount*.json
*ServiceAccount*.json
*firebase-adminsdk*.json
application_default_credentials.json
credentials.json
*-credentials.json
client_secret*.json
secrets/
.secrets/

# Private keys and application signing material (all project folders)
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# Local dependencies, emulator state and verification artifacts
**/node_modules/
**/.pytest_cache/
.firebase/
*.log
firebase-debug.log.*
firestore-debug.log.*
ui-debug.log.*
*.keras
*.backup-*

