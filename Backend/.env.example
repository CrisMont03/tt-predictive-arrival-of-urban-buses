ARRIBO_MODE=demo
ARRIBO_CORS_ORIGINS=http://localhost:8081
# Production: Application Default Credentials; no service-account keys in the repository.
GOOGLE_CLOUD_PROJECT=
TOMTOM_API_KEY=
# Minimum accepted speed-data confidence; not a congestion threshold.
TOMTOM_MIN_CONFIDENCE=0.5
# Bounded process-local TTLs; expired values are not served after provider errors.
TOMTOM_CACHE_SECONDS=60
ENV_ALERT_CACHE_SECONDS=300
# Informational warning only; older declarations retain their last published state.
ENV_ALERT_OLD_NOTICE_HOURS=24
ARRIBO_MODEL_DIR=
