ARRIBO_MODE=demo
ARRIBO_CORS_ORIGINS=http://localhost:8081
# Production: Application Default Credentials; no service-account keys in the repository.
GOOGLE_CLOUD_PROJECT=
TOMTOM_API_KEY=
# Minimum accepted speed-data confidence; not a congestion threshold.
TOMTOM_MIN_CONFIDENCE=0.5
# Bounded process-local TTLs; expired values are not served after provider errors.
TOMTOM_CACHE_SECONDS=60
ENV_ALERT_CACHE_SECONDS=300
# Informational warning only; older declarations retain their last published state.
ENV_ALERT_OLD_NOTICE_HOURS=24
ARRIBO_MODEL_DIR=
# Remote alternative: all three must be pinned; never combine with MODEL_DIR.
ARRIBO_MODEL_MANIFEST_URI=
ARRIBO_MODEL_MANIFEST_GENERATION=
ARRIBO_MODEL_MANIFEST_SHA256=
# Maintenance only; the API does not need access to snapshots or deployment permissions.
ARRIBO_REGISTRY_URI=
ARRIBO_CANDIDATES_URI=
ARRIBO_RELEASES_URI=
ARRIBO_TRAINING_SPEC_URI=
ARRIBO_TRAINING_SPEC_GENERATION=
ARRIBO_TRAINING_SPEC_SHA256=
ARRIBO_REGION=us-central1
ARRIBO_SERVICE=arribo-api
ARRIBO_API_IMAGE=
ARRIBO_AUTO_PROMOTION=false
ARRIBO_PROMOTOR_JOB=
ARRIBO_CODE_REVISION=
