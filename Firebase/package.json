{
  "name": "arribo-firebase-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Herramientas y pruebas locales de reglas Firestore para ARRIBO",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-arribo \"npm test\"",
    "test:integration": "firebase emulators:exec --only firestore --project demo-arribo \"../Backend/.venv/bin/python -m pytest -c ../Backend/pytest.ini ../Backend/tests/test_firestore_integration.py -q\"",
    "emulators:firestore": "firebase emulators:start --only firestore --project demo-arribo"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.34.0"
  }
}
